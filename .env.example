# Copy to .env and fill in. Never commit .env.

# --- Required: one credential (read by the credential proxy from .env only) ---
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=   # alternative: Claude subscription token
# ANTHROPIC_AUTH_TOKEN=      # alternative: bearer token for a custom ANTHROPIC_BASE_URL gateway

# --- Optional ---
# ASSISTANT_NAME=Andy        # default Andy; names the first agent created on first start
# TZ=                        # default: system timezone
# ANTHROPIC_BASE_URL=        # default https://api.anthropic.com
# INSTALL_CJK_FONTS=false    # set true to bake CJK fonts into the container image (container/build.sh)
# LOG_LEVEL=info             # debug | info | warn | error

# --- Slack (also uncomment its import in src/channels/index.ts) ---
# SLACK_BOT_TOKEN=           # xoxb-...
# SLACK_APP_TOKEN=           # xapp-... (enables Socket Mode)
# SLACK_SIGNING_SECRET=      # only for webhook mode when no app token is set
