# Copy to .env and fill in. Never commit .env.

# --- Required: one credential (read by the credential proxy from .env only) ---
ANTHROPIC_API_KEY=

# Alternative: a Claude subscription token
# CLAUDE_CODE_OAUTH_TOKEN=

# Alternative: a bearer token for a custom ANTHROPIC_BASE_URL gateway
# ANTHROPIC_AUTH_TOKEN=

# --- Optional ---

# Name of the first agent, created on first start (default: Andy)
# ASSISTANT_NAME=Andy

# IANA timezone, e.g. Europe/Berlin (default: the system timezone)
# TZ=

# API endpoint the credential proxy forwards to (default: https://api.anthropic.com)
# ANTHROPIC_BASE_URL=

# Set to true to bake CJK fonts into the agent image, then run `pnpm run build:image`
# INSTALL_CJK_FONTS=false

# --- Slack (also uncomment its import in src/channels/index.ts) ---

# Bot token, xoxb-...
# SLACK_BOT_TOKEN=

# App-level token, xapp-... (enables Socket Mode)
# SLACK_APP_TOKEN=

# Only for webhook mode, when no app token is set
# SLACK_SIGNING_SECRET=
